# Dependencies
node_modules/
.npm
*.tgz

# Build outputs (cockpit/install.sh keeps its cache in build/; ./cockpit/cleanup.sh removes it)
/build/
/dist/
/dist-server/
/dist-server.next/
/dist-server.old/
.vite/

# Local databases created by running the backend or the tests from the repo
/database/
*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.*
!.env.example

# Logs and runtime data
*.log
logs/
*.pid
*.pid.lock

# Test artifacts
coverage/
*.lcov
.nyc_output
playwright-report/
test-results/
# Test fixtures created beside the tests (cleaned up by the tests; kept out of the tree if a run is killed)
server/**/tests/read-only-roots-fixture-*/
server/**/tests/file-tree-outside-*/

# Temporary folders
tmp/
temp/
.tmp/
.cache/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# AI assistants' local files
.claude/
.cursor/
.codex/
CLAUDE.md
.mcp.json
.gemini/

# Git worktrees
.worktrees/
